rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function eduEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@ ]+@[^@ ]+\\.edu$');
    }
    function student() { return eduEmail() && request.auth.token.email_verified == true; }
    function validPhoto(d) {
      return !('photoUrl' in d)
        || (d.photoUrl is string && d.photoUrl.size() <= 65000
          && (d.photoUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
            || d.photoUrl.matches('^/listings/[A-Za-z0-9-]+\\.webp$')));
    }
    function validListing(d) {
      return d.keys().hasOnly(['id','sellerId','title','description','category',
          'priceCents','location','photoUrl','courseCode','status','createdAt'])
        && d.id is string && d.sellerId is string
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 1000
        && d.location is string && d.location.size() <= 100
        && d.category in ['Furniture','Electronics','Textbooks','Appliances','Clothing','Other']
        && d.priceCents is int && d.priceCents >= 0 && d.priceCents <= 1000000
        && d.createdAt is string && validPhoto(d);
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && eduEmail()
        && request.resource.data.keys().hasOnly(['id','name','email','dorm','joinedAt','stats'])
        && request.resource.data.id == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.stats == {'completedHandoffs':0,'thumbsUp':0,'thumbsDown':0};
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','dorm']);
      allow delete: if false;
    }
    match /publicProfiles/{uid} {
      allow get, list: if true;
      allow create: if student() && isOwner(uid)
        && request.resource.data.keys().hasOnly(['id','name','joinedAt','stats'])
        && request.resource.data.id == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.stats == {'completedHandoffs':0,'thumbsUp':0,'thumbsDown':0};
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;
    }
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if student()
        && request.resource.data.id == listingId
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'active'
        && validListing(request.resource.data);
      allow update: if student()
        && resource.data.sellerId == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.id == resource.data.id
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['active','removed']
        && validListing(request.resource.data);
      allow delete: if false;
    }
    match /saves/{saveId} {
      allow get: if signedIn() && saveId.matches(request.auth.uid + '_[A-Za-z0-9_-]+');
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if student()
        && request.resource.data.keys().hasOnly(['userId','listingId','savedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.listingId is string
        && request.resource.data.savedAt is string
        && saveId == request.auth.uid + '_' + request.resource.data.listingId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }
    // Private messages, deals, offers, payment and handoff data may only
    // be written by a trusted transactional server, not client SDK calls.
    match /{document=**} { allow read, write: if false; }
  }
}
